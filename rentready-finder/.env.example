# Server-side only. Never prefix these with VITE_ — that would expose them to the browser.
# Phase B: Google Places API (New). Restrict this key by API and by server IP/referrer.
GOOGLE_MAPS_API_KEY=
# Phase E: optional AI summaries / policy extraction.
OPENAI_API_KEY=
# Phase D (optional): policy verification records.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public, non-secret. Launch city used for the homepage "Explore Apartment Communities" section.
VITE_LAUNCH_CITY=Charlotte, NC
# Base URL of the server-side API (Netlify Functions in production).
VITE_API_BASE=/finder/api
