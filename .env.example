# =====================================================================
# RentReady funnel — environment variables
# Copy to .env.local for local work. NEVER commit real values.
# VITE_* values are PUBLIC (bundled into the browser). Never put secrets in a VITE_ variable.
# =====================================================================

# ---------- Browser (public) ----------
# mock = everything simulated locally (default). production = real /api calls, no simulated data.
VITE_FUNNEL_MODE=mock
# Where the API lives. Default "/api" = the Netlify Function in netlify/functions/api.mts.
# Point at the existing RentReady backend instead if preferred.
VITE_API_BASE_URL=/api
VITE_SITE_URL=https://werentreadygo.com
# Confirm the real support inbox before launch.
VITE_SUPPORT_EMAIL=
# Stripe PUBLISHABLE key only (pk_live_… / pk_test_…).
VITE_STRIPE_PUBLISHABLE_KEY=
# Force a hero headline variant: afford | income | found | worried (blank = default/test assignment)
VITE_HERO_VARIANT=
# Analytics (all optional; nothing loads when blank)
VITE_GTM_ID=
VITE_GA4_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=
VITE_GOOGLE_ADS_PURCHASE_LABEL=
VITE_GOOGLE_ADS_UPSELL_LABEL=
VITE_ANALYTICS_DEBUG=false
# Meta Pixel id (optional). Standard events only: PageView, ViewContent, Lead, InitiateCheckout, Purchase.
# No advanced matching — Meta never receives email/name/phone or quiz answers. Purchase eventID = Stripe PaymentIntent id.
VITE_META_PIXEL_ID=
# true = show a cookie banner; Google Consent Mode defaults to denied and Meta loads only after "Accept".
VITE_REQUIRE_TRACKING_CONSENT=false
# Show an explicit marketing-consent checkbox on /start and checkout (the free checklist always uses one).
# false = consent by clear notice at the form (US CAN-SPAM style). Stored per lead as consent_basis + consent_text.
VITE_REQUIRE_EMAIL_CONSENT=false
# Cloudflare Turnstile site key (public). Pair with TURNSTILE_SECRET_KEY below.
VITE_TURNSTILE_SITE_KEY=
# Hardcover delivery estimate for the Complete Kit, shown at checkout under the shipping address.
# Leave blank until your print partner gives you a real estimate — no shipping time is shown otherwise.
VITE_PHYSICAL_DELIVERY_NOTE=
# Money-back guarantee shown on the landing page (both products). Default 30. Set 0 to hide it.
# Before launch: publish the refund terms and make sure refunds are handled (see netlify/lib/api/webhooks/stripe.ts → charge.refunded).
VITE_MONEY_BACK_DAYS=30
# Footer legal links (absolute or site-relative). Leave empty to hide the link.
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# ---------- Server (Netlify → Site configuration → Environment variables; mark secrets as "Secret") ----------
# Stripe secret key (sk_live_… / sk_test_…). Used ONLY by the API function.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_…) for https://<your-site>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# 32+ random bytes for signing the HttpOnly session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Cloudflare Turnstile (anti-bot) secret key — optional; Turnstile works on any host
TURNSTILE_SECRET_KEY=
# Exact origin allowed to POST to /api (defaults to the request origin)
ALLOWED_ORIGIN=https://werentreadygo.com
# Database: Supabase PostgreSQL. Use the Transaction Pooler connection string (port 6543).
# In Supabase: Project Settings → Database → Connection string → Transaction pooler.
# Apply schema.sql once in the Supabase SQL Editor. Keep this connection string secret.
SUPABASE_DB_URL=
# Lifecycle → email. Every lifecycle fact is POSTed here as JSON (Klaviyo / Customer.io / Zapier / Make webhook).
ESP_WEBHOOK_URL=
# HMAC-SHA256 of the raw body, hex, sent as X-RentReady-Signature. Also the bearer for /api/esp/unsubscribe.
ESP_WEBHOOK_SECRET=
# Bearer for /api/admin/metrics (the /admin dashboard). `openssl rand -hex 32`
ADMIN_TOKEN=
# Private URL of the hosted step-by-step video guide. Only Digital Bundle owners are redirected to it (never put it in a VITE_ variable).
VIDEO_GUIDE_URL=

# ---------- Private product downloads (Cloudflare R2) ----------
# Create a private R2 bucket and an S3 API token with Object Read permission for this bucket.
# The API issues five-minute presigned download URLs only after checking the buyer's entitlement.
CLOUDFLARE_R2_ACCOUNT_ID=54e6c5629294da419009aaa2b7679f1a
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=creditrepairbusiness
# The Digital Bundle ZIP is at the bucket root: CREDIT REPAIR TOOLKIT™.zip.
# Other object keys are listed in src/config/resources.ts (see INTEGRATION_GUIDE.md).
# Abandoned-checkout detection runs automatically every 15 min (netlify/functions/abandoned-checkouts.mts).
