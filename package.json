{
  "name": "rentready-funnel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:finder": "cd rentready-finder && npm ci --no-audit --no-fund && npm run build && rm -rf ../dist/finder && cp -R dist ../dist/finder",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p netlify/tsconfig.json",
    "test": "node tests/run.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@libsql/client": "^0.15.15",
    "@netlify/functions": "^4.2.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
